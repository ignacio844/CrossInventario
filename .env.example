# demo: prueba local, con identidad de prueba explícita. sheets: operación con Google.
DATA_MODE=demo
PORT=4173
# Configurar en Google Cloud un cliente OAuth web y autorizar el origen de esta app.
GOOGLE_CLIENT_ID=
